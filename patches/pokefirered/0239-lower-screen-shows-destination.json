{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/item_menu.c","before_sha256":"7dfc349e6ae816fe13e0f175dedef266f97e5d1fc6f9323791eabccca5cd6514","after_sha256":"1e94a3e58a2dd39da3cc206ca4f0c4ba1a085eb10d2f279e81ca31148e1a3364","remove":false,"lines":[{"span":[0,2247]},{"port":"// The pocket the lower screen shows: FireRed moves gBagMenuState.pocket to a new pocket only at the end of its switch's\n"},{"port":"// animation (Task_AnimateSwitchPockets), but that pocket's count, cursor and items are its own from the start, so the\n"},{"port":"// pocket being revealed is reported at once.\n"},{"port":"static u8 CtrBagShownPocket(void)\n"},{"port":"{\n"},{"port":"    u8 taskId;\n"},{"port":"\n"},{"port":"    if (BagTask(&taskId) && gTasks[taskId].func == Task_AnimateSwitchPockets)\n"},{"port":"    {\n"},{"port":"        s16 *data = gTasks[taskId].data;\n"},{"port":"        int pocket = gBagMenuState.pocket + tSwitchDir;\n"},{"port":"\n"},{"port":"        if (pocket >= POCKET_ITEMS - 1 && pocket <= POCKET_POKE_BALLS - 1)\n"},{"port":"            return pocket;\n"},{"port":"    }\n"},{"port":"    return gBagMenuState.pocket;\n"},{"port":"}\n"},{"port":"\n"},{"span":[2247,3]},{"port":"    return sBagMenuDisplay != NULL ? sBagMenuDisplay->nItems[CtrBagShownPocket()] : 0;\n"},{"span":[2251,4]},{"port":"    return sBagMenuDisplay != NULL ? sBagMenuDisplay->maxShowed[CtrBagShownPocket()] : 0;\n"},{"span":[2256,8]},{"port":"    return GetSelectedItemIndex(CtrBagShownPocket());\n"},{"span":[2265,10]},{"port":"    return (unsigned)CtrBottomBag_State() | (unsigned)CtrBagShownPocket() << 4\n"},{"span":[2276,8]},{"port":"    return BagGetItemIdByPocketPosition(CtrBagShownPocket() + 1, index);\n"},{"span":[2285,4]},{"port":"    CtrPokeTouch_Text(sPocketNames[CtrBagShownPocket()], 32, out, size);\n"},{"span":[2290,78]},{"port":"    return CtrBagShownPocket();\n"},{"span":[2369,6]},{"port":"    return BagGetQuantityByPocketPosition(CtrBagShownPocket() + 1, index);\n"},{"span":[2376,438]}]},{"path":"src/party_menu.c","before_sha256":"fa80ee477bf714c19ffb47710be4a41ced5963f19ff74eb4a5d0d210a335c80b","after_sha256":"4d09d265b13162572308462b964daf24ca87fb2e30551456b96c179d9bc8e048","remove":false,"lines":[{"span":[0,6885]},{"port":"// The slot the lower screen shows as the Party's selection: FireRed's cursor pointer, but while two Pokemon slide to\n"},{"port":"// their places (SWITCHING) that pointer is the first one's again until the slide ends on the second's slot, so the\n"},{"port":"// second is reported, where the cursor lands.\n"},{"port":"static int CtrPartyShownSlot(void)\n"},{"port":"{\n"},{"port":"    if (gPartyMenu.action == PARTY_ACTION_SWITCHING)\n"},{"port":"        return gPartyMenu.slotId2;\n"},{"port":"    return *GetCurrentPartySlotPtr();\n"},{"port":"}\n"},{"port":"\n"},{"span":[6885,2]},{"port":"    return CtrPartyShownSlot();\n"},{"span":[6888,182]}]}]}
