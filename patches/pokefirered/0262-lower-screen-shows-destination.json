{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/item_menu.c","before_sha256":"757f0a4185699ac38cbbc960a74bd1b8ad63baf994226b51237ae34960d8fc0a","after_sha256":"f702ef18301c0ccfd2cd5c43e99c53c7f166f53934bb4cc538d59a9427890f80","remove":false,"lines":[{"span":[0,2261]},{"port":"// The pocket the lower screen shows: FireRed moves gBagMenuState.pocket to a new pocket only at the end of its switch's\n"},{"port":"// animation (Task_AnimateSwitchPockets), but that pocket's count, cursor and items are its own from the start, so the\n"},{"port":"// pocket being revealed is reported at once.\n"},{"port":"static u8 CtrBagShownPocket(void)\n"},{"port":"{\n"},{"port":"    u8 taskId;\n"},{"port":"\n"},{"port":"    if (BagTask(&taskId) && gTasks[taskId].func == Task_AnimateSwitchPockets)\n"},{"port":"    {\n"},{"port":"        s16 *data = gTasks[taskId].data;\n"},{"port":"        int pocket = gBagMenuState.pocket + tSwitchDir;\n"},{"port":"\n"},{"port":"        if (pocket >= POCKET_ITEMS - 1 && pocket <= POCKET_POKE_BALLS - 1)\n"},{"port":"            return pocket;\n"},{"port":"    }\n"},{"port":"    return gBagMenuState.pocket;\n"},{"port":"}\n"},{"port":"\n"},{"span":[2261,3]},{"port":"    return sBagMenuDisplay != NULL ? sBagMenuDisplay->nItems[CtrBagShownPocket()] : 0;\n"},{"span":[2265,4]},{"port":"    return sBagMenuDisplay != NULL ? sBagMenuDisplay->maxShowed[CtrBagShownPocket()] : 0;\n"},{"span":[2270,8]},{"port":"    return GetSelectedItemIndex(CtrBagShownPocket());\n"},{"span":[2279,10]},{"port":"    return (unsigned)CtrBottomBag_State() | (unsigned)CtrBagShownPocket() << 4\n"},{"span":[2290,8]},{"port":"    return BagGetItemIdByPocketPosition(CtrBagShownPocket() + 1, index);\n"},{"span":[2299,4]},{"port":"    CtrPokeTouch_Text(sPocketNames[CtrBagShownPocket()], 32, out, size);\n"},{"span":[2304,78]},{"port":"    return CtrBagShownPocket();\n"},{"span":[2383,6]},{"port":"    return BagGetQuantityByPocketPosition(CtrBagShownPocket() + 1, index);\n"},{"span":[2390,438]}]},{"path":"src/party_menu.c","before_sha256":"1ebd636f80cab1cf8d68acdbc9ec79684b6f7fba734d6cf0c65623ea63e9d30a","after_sha256":"bcf7fe9b1cf3fd906aa2937078e646c267b13ed249e91bb7f9c313b531786433","remove":false,"lines":[{"span":[0,7002]},{"port":"// The slot the lower screen shows as the Party's selection: FireRed's cursor pointer, but while two Pokemon slide to\n"},{"port":"// their places (SWITCHING) that pointer is the first one's again until the slide ends on the second's slot, so the\n"},{"port":"// second is reported, where the cursor lands.\n"},{"port":"static int CtrPartyShownSlot(void)\n"},{"port":"{\n"},{"port":"    if (gPartyMenu.action == PARTY_ACTION_SWITCHING)\n"},{"port":"        return gPartyMenu.slotId2;\n"},{"port":"    return *GetCurrentPartySlotPtr();\n"},{"port":"}\n"},{"port":"\n"},{"span":[7002,2]},{"port":"    return CtrPartyShownSlot();\n"},{"span":[7005,182]}]}]}
