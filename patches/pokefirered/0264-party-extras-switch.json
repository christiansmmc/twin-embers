{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/party_menu.c","before_sha256":"e2c84db58c03bb76cedcd99f49ea47f47cecd0e03a562c9f50ca7d9bda99ce6e","after_sha256":"5f9fb7fc4eaeabe97a028c358499d0fe9221e9482f966af3a9da3b9736125d5d","remove":false,"lines":[{"span":[0,3162]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// HEAL and REMEMBER (recipes 0235 and 0238) are out of the Party's menu: the owner's call. Their callbacks, texts and the\n"},{"port":"// dispatch by id stay compiled, so setting the switch to 1 is all it takes to bring them back.\n"},{"port":"#ifndef CTR_PARTY_EXTRAS\n"},{"port":"#define CTR_PARTY_EXTRAS 0 /* 1 brings HEAL and REMEMBER back to the Party's menu; their code stays compiled */\n"},{"port":"#endif\n"},{"port":"#if CTR_PARTY_EXTRAS\n"},{"port":"// REMEMBER, then HEAL, while the list has room: it holds eight, so a Pokemon with four field moves has none for HEAL.\n"},{"port":"static void CtrAppendPartyExtras(void)\n"},{"port":"{\n"},{"port":"    if (sPartyMenuInternal->numActions < 7)\n"},{"port":"        AppendToList(sPartyMenuInternal->actions, &sPartyMenuInternal->numActions, CURSOR_OPTION_RELEARN);\n"},{"port":"    if (sPartyMenuInternal->numActions < 7)\n"},{"port":"        AppendToList(sPartyMenuInternal->actions, &sPartyMenuInternal->numActions, CURSOR_OPTION_HEAL);\n"},{"port":"}\n"},{"port":"#endif\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[3162,31]},{"port":"#if CTR_PARTY_EXTRAS\n"},{"port":"    CtrAppendPartyExtras();\n"},{"port":"#endif\n"},{"span":[3197,4015]}]}]}
